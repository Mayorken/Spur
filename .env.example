# ═══════════════════════════════════════════════════════════════════════════════
# Spur Environment Configuration
# Copy this to .env and fill in your production values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Spur
DEBUG=false
API_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────────────────────────────
# Development (SQLite)
# DATABASE_URL=sqlite:///./spur.db

# Production (PostgreSQL via Railway, Heroku, or Supabase)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/spur

# ─── Redis (Optional) ────────────────────────────────────────────────────────
# For scaling WebSocket across multiple processes
# Leave blank to use in-memory ConnectionManager (single process only)
REDIS_URL=redis://localhost:6379

# ─── JWT & Security ──────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-min-32-characters-change-in-production

# Admin access key for /admin endpoints
ADMIN_SECRET_KEY=your-admin-key-min-32-characters

# ─── CORS (Cross-Origin Resource Sharing) ───────────────────────────────────
# Development: "*" (allow all)
# Production: "https://app.example.com,https://www.example.com"
CORS_ORIGINS=https://spur-app.vercel.app

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# SendGrid Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key-here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Spur

# ─── Frontend URL ────────────────────────────────────────────────────────────
# Used in email reset links, Stripe redirects
FRONTEND_URL=https://spur-app.vercel.app

# ─── Stripe Payments ────────────────────────────────────────────────────────
# Leave blank for dev mode (auto-grants premium)
# Live keys: sk_live_... and whsec_...
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_PREMIUM_USD=1500

# ─── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ─── Location & Matching ────────────────────────────────────────────────────
DEFAULT_RADIUS_KM=0.5
MAX_RADIUS_KM=5.0

# ─── Chat Settings ──────────────────────────────────────────────────────────
CHAT_AUTO_CLEAR_HOURS=24

# ─── Matching Intents ───────────────────────────────────────────────────────
INTENT_ACTIVE_MINUTES=60
INTENT_CLEANUP_INTERVAL_MINUTES=15

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
